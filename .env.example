# Memos TUI Configuration
# Copy this file to .env and fill in your values

# Your Memos instance API URL (required)
# Example: https://memos.example.com/api/v1
MEMOS_API_URL=

# Your Memos API access token (required)
# Get this from your Memos instance: Settings > My Account > Access Tokens
MEMOS_AUTH_TOKEN=
